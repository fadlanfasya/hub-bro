# Copy this file to .env and adjust. Never commit the real .env.

# Signing key for auth tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# How long a login stays valid (minutes). Default: 1 day.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database. Default is a local SQLite file.
# Postgres example: postgresql+psycopg://user:pass@localhost/hubbro
DATABASE_URL=

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cache fetched data briefly so several widgets on one source share a request.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=15

# Timeout for outbound requests to your data sources (seconds).
FETCH_TIMEOUT_SECONDS=30
