# Production settings for docker-compose. Copy to .env and fill in.
#   cp .env.example .env
# Never commit the real .env.

# REQUIRED. The app refuses to start in production without this.
# Generate one with:
#   docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later logs everyone out AND makes stored data-source
# credentials unreadable — they would need re-entering.
SECRET_KEY=

# Port on the host. The app listens on 8000 inside the container.
HOST_PORT=8080

# Origins allowed to call the API from a browser. Include the address people
# actually type, including the port. Do not use "*".
CORS_ORIGINS=http://localhost:8080

# How long a login lasts, in minutes. Default is 1 day.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cache fetched data briefly so several widgets on one source share a request.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=15

# Share the cache across workers. Leave empty for a single-worker deployment.
# Uncomment the redis service in docker-compose.yml before setting this.
# REDIS_URL=redis://redis:6379/0

# Timeout for outbound requests to your data sources, in seconds.
FETCH_TIMEOUT_SECONDS=30

# How often to probe data sources that have "check on a timer" enabled.
# Sources without it are only checked when a widget actually fetches from them.
# Set to 0 to disable the background monitor entirely.
HEALTH_CHECK_INTERVAL=300
